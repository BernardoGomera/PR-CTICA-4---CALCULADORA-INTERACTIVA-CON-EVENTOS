<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="Practica4_Calculadora_Interactiva.MainPage"
             Title="Calculadora"
             BackgroundColor="#E9EEF5">

    <Grid Padding="20"
          RowSpacing="10"
          ColumnSpacing="10"
          RowDefinitions="Auto,*,*,*,*,*"
          ColumnDefinitions="*,*,*,*">

        <Frame Grid.Row="0"
               Grid.ColumnSpan="4"
               BackgroundColor="#F5F5F5"
               Padding="15"
               CornerRadius="10"
               HasShadow="False"
               Margin="0,0,0,20">
            <VerticalStackLayout Spacing="2">
                <Label x:Name="lblHistorial"
                       Text=""
                       FontSize="12"
                       HorizontalOptions="End"
                       TextColor="Gray"
                       LineBreakMode="TailTruncation"
                       MaxLines="3" />

                <Label x:Name="lblDisplay"
                       Text="0"
                       FontSize="48"
                       HorizontalOptions="End"
                       VerticalOptions="Center"
                       TextColor="#000000"
                       LineBreakMode="NoWrap" />
            </VerticalStackLayout>
        </Frame>

        <Button Grid.Row="1"
                Grid.Column="0"
                Text="C"
                FontSize="24"
                BackgroundColor="#FF6B6B"
                TextColor="White"
                Clicked="OnClearClicked" />

        <Button Grid.Row="1"
                Grid.Column="1"
                Text="÷"
                FontSize="24"
                BackgroundColor="#4ECDC4"
                TextColor="White"
                Clicked="OnOperatorClicked" />

        <Button Grid.Row="1"
                Grid.Column="2"
                Text="×"
                FontSize="24"
                BackgroundColor="#4ECDC4"
                TextColor="White"
                Clicked="OnOperatorClicked" />

        <Button Grid.Row="1"
                Grid.Column="3"
                Text="-"
                FontSize="24"
                BackgroundColor="#4ECDC4"
                TextColor="White"
                Clicked="OnOperatorClicked" />

        <Button Grid.Row="2"
                Grid.Column="0"
                Text="7"
                FontSize="24"
                BackgroundColor="#95E1D3"
                Clicked="OnNumberClicked" />

        <Button Grid.Row="2"
                Grid.Column="1"
                Text="8"
                FontSize="24"
                BackgroundColor="#95E1D3"
                Clicked="OnNumberClicked" />

        <Button Grid.Row="2"
                Grid.Column="2"
                Text="9"
                FontSize="24"
                BackgroundColor="#95E1D3"
                Clicked="OnNumberClicked" />

        <Button Grid.Row="2"
                Grid.Column="3"
                Text="+"
                FontSize="24"
                BackgroundColor="#4ECDC4"
                TextColor="White"
                Clicked="OnOperatorClicked" />

        <Button Grid.Row="3"
                Grid.Column="0"
                Text="4"
                FontSize="24"
                BackgroundColor="#95E1D3"
                Clicked="OnNumberClicked" />

        <Button Grid.Row="3"
                Grid.Column="1"
                Text="5"
                FontSize="24"
                BackgroundColor="#95E1D3"
                Clicked="OnNumberClicked" />

        <Button Grid.Row="3"
                Grid.Column="2"
                Text="6"
                FontSize="24"
                BackgroundColor="#95E1D3"
                Clicked="OnNumberClicked" />

        <Button Grid.Row="4"
                Grid.Column="0"
                Text="1"
                FontSize="24"
                BackgroundColor="#95E1D3"
                Clicked="OnNumberClicked" />

        <Button Grid.Row="4"
                Grid.Column="1"
                Text="2"
                FontSize="24"
                BackgroundColor="#95E1D3"
                Clicked="OnNumberClicked" />

        <Button Grid.Row="4"
                Grid.Column="2"
                Text="3"
                FontSize="24"
                BackgroundColor="#95E1D3"
                Clicked="OnNumberClicked" />

        <Button Grid.Row="5"
                Grid.Column="0"
                Grid.ColumnSpan="2"
                Text="0"
                FontSize="24"
                BackgroundColor="#95E1D3"
                Clicked="OnNumberClicked" />

        <Button Grid.Row="5"
                Grid.Column="2"
                Text="."
                FontSize="24"
                BackgroundColor="#95E1D3"
                Clicked="OnNumberClicked" />

        <Button Grid.Row="3"
                Grid.Column="3"
                Grid.RowSpan="3"
                Text="="
                FontSize="32"
                FontAttributes="Bold"
                BackgroundColor="#0078D4"
                TextColor="White"
                Clicked="OnEqualsClicked" />

    </Grid>
</ContentPage>
